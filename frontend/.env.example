# Optional frontend settings. Copy to ".env" only if you need to change them.
# Never put API keys here: everything prefixed VITE_ is shipped to the browser.

# Where the Vite dev server proxies /api requests (the FastAPI backend).
VITE_BACKEND_URL=http://127.0.0.1:8000

# Base path of the API as seen by the browser. Leave as /api unless the
# backend is hosted on a different origin, e.g. https://policygen.example.com/api
VITE_API_BASE=/api
