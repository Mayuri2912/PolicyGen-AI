# PolicyGen AI - backend configuration
# Copy this file to ".env" in the same folder and edit the values.
# Never commit .env or put a real key in any other file.

# --- LLM provider -------------------------------------------------------------
# auto      = Claude when ANTHROPIC_API_KEY is set, else Gemini when GEMINI_API_KEY is set,
#             else OpenRouter when OPENROUTER_API_KEY is set, otherwise mock mode
# anthropic = require Claude (jobs fail with a clear message if no key is set)
# gemini    = require Google Gemini (jobs fail with a clear message if no key is set)
# openrouter = require OpenRouter (jobs fail with a clear message if no key is set)
# mock      = rule-based simulated output, no API key needed, nothing leaves the server
# A named provider is never replaced by another one: if its key is missing the
# app says so. The settings in this section and the provider sections below are
# re-read when this file is saved; other settings need a backend restart.
LLM_PROVIDER=auto

# --- Anthropic Claude ---
# Create a key at https://console.anthropic.com/ -> API keys, then paste it here.
ANTHROPIC_API_KEY=

ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (thinking depth and cost)
ANTHROPIC_EFFORT=high
ANTHROPIC_MAX_OUTPUT_TOKENS=32000
# Constrain responses to the task's JSON schema (falls back automatically if rejected).
ANTHROPIC_STRUCTURED_OUTPUTS=true
# Let the API re-run a request on Anthropic's recommended fallback model if a
# safety classifier declines it (falls back automatically if not available).
ANTHROPIC_REFUSAL_FALLBACK=true

# --- Google Gemini ---
# Create a key at https://aistudio.google.com/apikey, then paste it here.
# The key stays on the server: it is never sent to the browser or written to logs.
GEMINI_API_KEY=
# Any text-generation model your key can use. Older ids are retired over time (gemini-2.5-flash
# is already closed to new users); the server reports a clear error if the id is not available.
GEMINI_MODEL=gemini-3.8-flash
# Upper limit for one response. Thinking tokens count towards it on Gemini.
GEMINI_MAX_OUTPUT_TOKENS=65536
# Constrain responses to the task's JSON schema (falls back automatically if rejected).
GEMINI_STRUCTURED_OUTPUTS=true

# --- OpenRouter (one key, many models, including free ones) ---
# Create a key at https://openrouter.ai/keys, then paste it here (it starts with
# "sk-or-"; a Gemini or Anthropic key does not work here), and set
# LLM_PROVIDER=openrouter above. Check it with: scripts\check_openrouter.py
# The key stays on the server: it is never sent to the browser or written to logs.
OPENROUTER_API_KEY=
# Any model id from https://openrouter.ai/models, for example:
#   openrouter/free            lets OpenRouter pick a free model (default); a
#                              different model answers each request, so speed
#                              and quality vary
#   nvidia/nemotron-3-super-120b-a12b:free
#                              recommended: the fastest free model verified
#                              with this application (October 2026)
#   <vendor>/<model>:free      a specific free model (ids ending in ":free")
#   <vendor>/<model>           a paid model (needs credit on the account)
# Free models must be allowed in the account's privacy settings and are limited
# per minute and per day (about 50 requests a day; 1000 once the account has
# bought at least 10 credits).
OPENROUTER_MODEL=openrouter/free
# Upper limit for one response. 0 sends no limit and leaves it to the model.
OPENROUTER_MAX_OUTPUT_TOKENS=32000
# Ask for JSON constrained to the task's schema. Models that cannot do this are
# detected and the request falls back to plain JSON automatically.
OPENROUTER_STRUCTURED_OUTPUTS=true
# off | low | medium | high | default. Free reasoning models can think for minutes
# before answering; off asks them not to (a model that cannot is used as it is).
OPENROUTER_REASONING=off
# Documents are sent in parts of this many characters (never above CHUNK_MAX_CHARS).
# Free models write slowly and the findings are several times longer than the text,
# so small parts keep each request short. More parts mean more requests.
OPENROUTER_CHUNK_MAX_CHARS=5000
# Total seconds allowed for one request, including the whole answer. A request
# that exceeds it is tried once more, then the job fails with the reason.
OPENROUTER_TIMEOUT_SECONDS=600

# --- Settings shared by all providers ---
LLM_TIMEOUT_SECONDS=300
LLM_MAX_RETRIES=2
# How many times an invalid JSON response is sent back for repair.
LLM_JSON_REPAIR_ATTEMPTS=1
# Extra LLM calls allowed to fix issues found by the policy quality checks.
QUALITY_CORRECTION_ROUNDS=1
# Largest piece of a document sent in one request (characters, roughly 4 per token).
CHUNK_MAX_CHARS=48000
MAX_CHUNKS_PER_ANALYSIS=40

# --- Uploads and extraction ---------------------------------------------------
MAX_UPLOAD_MB=25
MAX_FILES_PER_UPLOAD=10
MAX_PDF_PAGES=500
MAX_TABLE_ROWS=5000
MAX_EXTRACTED_CHARS=2000000
MAX_ARCHIVE_UNCOMPRESSED_MB=300
EXTRACTION_TIMEOUT_SECONDS=120

# --- OCR ----------------------------------------------------------------------
# auto      = use Tesseract if it is installed
# tesseract = require Tesseract
# claude    = transcribe images with the Claude API (sends images to Anthropic)
# none      = disable OCR
OCR_ENGINE=auto
# Full path to tesseract.exe if it is not on PATH, for example:
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# --- Storage and database -----------------------------------------------------
# Folder for uploads, extracted content, generated reports and the SQLite file.
# Defaults to backend/data when empty.
# DATA_DIR=D:\policygen-data
# Leave empty for SQLite in DATA_DIR. PostgreSQL example (also: pip install "psycopg[binary]"):
# DATABASE_URL=postgresql+psycopg://policygen:password@localhost:5432/policygen
DATABASE_URL=
# Optional extra folder of policy-type JSON files.
POLICY_TEMPLATES_DIR=

# --- Privacy and retention ----------------------------------------------------
# Delete uploads, analyses and reports older than this many hours. 0 = keep until deleted.
RETENTION_HOURS=0
# Delete the uploaded source file as soon as its text has been extracted.
DELETE_SOURCE_AFTER_EXTRACTION=false

# --- API security -------------------------------------------------------------
# Browser origins allowed to call the API (the Vite dev server by default).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional shared secret. When set, every request must send "Authorization: Bearer <token>"
# and the web app asks for it once per browser session.
API_ACCESS_TOKEN=
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_HEAVY_PER_MINUTE=40

# --- Risk scoring -------------------------------------------------------------
# Upper bounds of likelihood x impact for Low, Medium, High. Above the last = Critical.
RISK_LEVEL_THRESHOLDS=4,9,15

# --- Misc ---------------------------------------------------------------------
JOB_WORKERS=3
LOG_LEVEL=INFO
ENVIRONMENT=development
